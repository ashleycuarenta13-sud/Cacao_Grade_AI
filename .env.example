# CacaoGrade AI - environment template (Activity 3, Part F)
#
# Copy to `.env` at the repository root and edit. The real `.env` is
# gitignored: the document's Part F says so explicitly, and none of these
# values may end up in a public repository.
#
#     copy .env.example .env
#
# Everything here has a working local default, so deleting the file entirely
# is also valid - it only becomes necessary once you change a value.

# ---------------------------------------------------------------- API / CNN

# Public base URL of the FastAPI backend. The Flutter client reads its
# equivalent through a dart-define instead of a file:
#
#   flutter run -d chrome --dart-define=CACAO_API=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000

# The inference service the backend forwards each photo to. Point this at the
# container or Cloud Run service that runs cnn_service.
CNN_SERVICE_URL=http://127.0.0.1:8001/predict

# ------------------------------------------------------------------ database

# Activity 3 names PostgreSQL 15. Local coursework value is the default, so
# this line is only needed when the database is somewhere else.
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/cacao_gradeai

# ------------------------------------------------------------------- auth

# Signing key for the HS256 JWT. Leave unset locally and the backend
# generates and persists one to backend/.jwt_secret. In any shared or
# deployed environment it must be set explicitly.
# JWT_SECRET=change-me-to-64-random-hex-characters

# Token lifetime in seconds (default 43200 = 12 hours).
# CACAO_JWT_TTL=43200

# -------------------------------------------------------------- storage

# Activity 3 splits photo storage off from the API ("Application/Backend Must
# Not Be Responsible For ... storing production data in local files"). The
# local build writes to backend/uploads/ and serves it back through
# GET /uploads/{name}; set this when the backend is switched to a bucket.
# CLOUD_STORAGE_BUCKET=
